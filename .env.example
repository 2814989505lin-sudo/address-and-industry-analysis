# 示例值；所有账户、密码、服务地址均需使用你自己的授权测试环境。
# 本文件只是配置说明。产业链模块自动读取模块根目录下的 .env；
# 其他脚本的读取机制不同，统一使用进程环境变量最直接。
SR_TARGET_DSN=mysql+pymysql://demo_user:replace_me@127.0.0.1:9030/demo_target
SR_SOURCE_DSN=mysql+pymysql://demo_user:replace_me@127.0.0.1:9030/demo_source
SR_HTTP_HOST=127.0.0.1
SR_HTTP_PORT=8030
SR_HTTP_USER=demo_user
SR_HTTP_PASSWORD=replace_me
SR_TARGET_DB=demo_target
SR_DB_HOST=127.0.0.1
SR_DB_USER=demo_user
SR_DB_PASSWORD=replace_me
LLM_API_KEY=replace_me
LLM_API_URL=https://your-model-service.example/v1/chat/completions
EMBEDDING_API_KEY=replace_me
EMBEDDING_API_URL=https://your-embedding-service.example/v1/embeddings
AMAP_API_KEY=replace_me
SILICONFLOW_API_KEY=replace_me
ANTHROPIC_API_KEY=replace_me
MINIMAX_API_KEY=replace_me
ANTHROPIC_BASE_URL=https://your-anthropic-service.example
